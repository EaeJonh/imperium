# Copie para .env.local (nunca commite) ou cadastre em Vercel → Settings → Environment Variables.

# Supabase → Project Settings → API
SUPABASE_URL=https://SEU-PROJETO.supabase.co
# chave pública (anon / publishable): vai para o navegador via /api/public-config
SUPABASE_ANON_KEY=
# chave secreta (service_role / secret): só no servidor, nunca em public/
SUPABASE_SERVICE_ROLE_KEY=

# origens que podem chamar /api/ref, separadas por vírgula
ALLOWED_ORIGINS=https://imperiumblox.shop,https://www.imperiumblox.shop
