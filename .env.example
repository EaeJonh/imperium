# Copie para .env.local (nunca commite) ou cadastre em Vercel → Settings → Environment Variables.
# Os nomes seguem o padrão antigo do Supabase, mas os valores são as chaves atuais.

# Supabase → Project Settings → API Keys
SUPABASE_URL=https://SEU-PROJETO.supabase.co
# chave publicável (sb_publishable_...): vai para o navegador via /api/public-config
SUPABASE_ANON_KEY=
# chave secreta (sb_secret_...): só no servidor, nunca em public/
SUPABASE_SERVICE_ROLE_KEY=

# opcional: outros domínios que podem chamar /api/ref, separados por vírgula.
# O próprio site (imperiumblox.shop e os Previews) já é aceito automaticamente.
ALLOWED_ORIGINS=
