# Copie para .env.local (nunca commite) ou cadastre em Vercel → Settings → Environment Variables.

# Supabase → Project Settings → API Keys
SUPABASE_URL=https://SEU-PROJETO.supabase.co
# chave publicável (sb_publishable_...): vai para o navegador via /api/public-config
SUPABASE_PUBLISHABLE_KEY=
# chave secreta (sb_secret_...): só no servidor, nunca em public/
SUPABASE_SECRET_KEY=

# origens que podem chamar /api/ref, separadas por vírgula
ALLOWED_ORIGINS=https://imperiumblox.shop,https://www.imperiumblox.shop
